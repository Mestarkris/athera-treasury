# Athera Treasury runtime secrets. `pnpm keygen` creates .env (mode 600) and fills the keys.
# This example must stay value-less: the pre-commit hook rejects secret-like strings.
# Account IDs are NOT here; they live in config.yaml (accounts.treasury / accounts.revenue).

# NEAR mainnet RPC (see docs/decisions.md D1). Default: https://rpc.mainnet.fastnear.com
NEAR_RPC_URL=

# FUNCTION-CALL key on accounts.treasury: receiver intents.near, method execute_intents,
# no deposit. Also registered in intents.near (add_public_key) to sign the treasury's intents.
# The runtime refuses to start if this is a full-access key.
ATHERA_TREASURY_FC_KEY=

# Intent-signing key for accounts.revenue. Registered ONLY inside intents.near
# (add_public_key); it is not an access key on the NEAR account at all.
ATHERA_REVENUE_INTENT_KEY=

# Hosted site (Vercel). The Upstash Redis REST URL and token the site uses; `pnpm worker`
# publishes to it and picks up orders from it. Add them with `pnpm store:keys` (token hidden).
KV_REST_API_URL=
KV_REST_API_TOKEN=
